# Copy to an ignored .env.local (or .env). Use your local API origin only,
# without /api/v1 or the endpoint path. No backend is needed for builds/tests.
API_INTERNAL_URL=http://localhost:8080
# Required NODE_ENV is supplied by Next.js/Vitest: development/test/production.
# Public environment allowlist remains empty. Never prefix secrets with NEXT_PUBLIC_.
# npm registry authentication belongs in user-level npm config, not this file.
