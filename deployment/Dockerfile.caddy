# Rebuild the exact upstream release with the patched compiler/network module.
FROM golang:1.26.10-alpine@sha256:9ce231b28998b32e116927c61aa5c406183061d4f3f2d61b292c88e7f6bdf7ca AS builder
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /build
RUN go mod init medical-web-edge && \
    go get github.com/caddyserver/caddy/v2@v2.11.7 golang.org/x/net@v0.60.0 && \
    go build -mod=mod -trimpath -ldflags="-s -w" -o /caddy github.com/caddyserver/caddy/v2/cmd/caddy

FROM caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
# The base still ships brotli-libs 1.2.0-r0 (CVE-2026-111497, HIGH; only curl uses it, and the
# health check uses busybox wget). Take Alpine's fixed package until upstream rebuilds the image;
# drop this once the pinned base includes brotli-libs >= 1.2.1-r0.
RUN apk upgrade --no-cache brotli-libs
COPY --from=builder /caddy /usr/bin/caddy
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION \
      org.opencontainers.image.source="https://github.com/dadzhioski/professional-services-medical-web" \
      io.professional-services.caddy.version="2.11.7" \
      io.professional-services.caddy.go="1.26.10" \
      io.professional-services.caddy.x-net="0.60.0"
